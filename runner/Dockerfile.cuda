# GPU variant of runner/Dockerfile. Identical except torch/torchvision come from
# the cu124 index. The pip wheels bundle their own CUDA runtime and cuDNN, so no
# nvidia/cuda base image is needed - the HOST only needs an NVIDIA driver (CUDA
# 12.4+ capable) and the NVIDIA container toolkit, and the run needs `--gpus all`
# (runner/ passes it for --gpu). x86_64 only: aarch64 CUDA wheels are a different
# story and Blackwell (sm_120+) would need a newer torch than this pin.
# Everything else - bind mounts, caches, why nothing generated is COPY'd in -
# is explained in runner/Dockerfile and is unchanged here.

FROM python:3.11-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false

ENV HOME=/cache \
    XDG_CACHE_HOME=/cache \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch

# Bare 2.5.1 / 0.20.1 resolve to the +cu124 wheels on this index (verified to
# exist for cp311 linux_x86_64). --index-url keeps the CPU build from PyPI out.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.5.1 \
        torchvision==0.20.1

RUN pip install --no-cache-dir \
        transformers==4.46.3 \
        accelerate==1.1.1 \
        numpy==2.1.3 \
        pillow==11.0.0

# 0777 so a run under `--user <uid>:<gid>` (no matching passwd entry) can still
# write HOME=/cache when the host mount is created by the daemon as root.
RUN mkdir -p /workspace /workspace/data /cache && chmod 0777 /cache

WORKDIR /workspace
CMD ["bash", "reproduce.sh", "probe"]
